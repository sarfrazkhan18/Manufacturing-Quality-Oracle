# Manufacturing Quality Oracle - Configuration

# Application Settings
APP_NAME="Manufacturing Quality Oracle"
APP_VERSION="1.0.0"
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Roboflow API
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_WORKSPACE=your_workspace
ROBOFLOW_PROJECT=defect-detection

# AI Model Configuration
YOLO_MODEL_PATH=./models/yolov8n.pt
CUSTOM_MODEL_PATH=./models/custom_defect_detector.pt
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.45
MODEL_VERSION=v1.0

# Reflection Agent API Keys
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
REFLECTION_MODEL=gpt-4
REFLECTION_TEMPERATURE=0.7

# Camera Configuration
CAMERA_RESOLUTION_WIDTH=1920
CAMERA_RESOLUTION_HEIGHT=1080
CAMERA_FPS=30
CAMERA_BUFFER_SIZE=10
CAMERA_IDS=0,1,2  # Comma-separated camera indices

# Edge Device Settings
EDGE_DEVICE_TYPE=jetson  # Options: jetson, intel_nuc, generic
EDGE_COMPUTE_THREADS=4
GPU_ACCELERATION=true
TENSORRT_OPTIMIZATION=true

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quality_oracle
DB_USER=postgres
DB_PASSWORD=your_secure_password

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# MongoDB (for unstructured data)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=quality_oracle
MONGO_USER=admin
MONGO_PASSWORD=your_mongo_password

# MES/ERP Integration
MES_API_URL=http://your-mes-system.com/api
MES_API_KEY=your_mes_api_key
ERP_API_URL=http://your-erp-system.com/api
ERP_API_KEY=your_erp_api_key

# OPC UA Industrial Protocol
OPCUA_SERVER_URL=opc.tcp://localhost:4840
OPCUA_NAMESPACE=http://manufacturing.oracle/
OPCUA_USERNAME=
OPCUA_PASSWORD=

# MQTT Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=quality/oracle
MQTT_QOS=2

# PLC Communication
PLC_IP_ADDRESS=192.168.1.100
PLC_PORT=502
PLC_UNIT_ID=1

# Alert & Notification
ALERT_EMAIL_ENABLED=true
ALERT_EMAIL_SMTP_HOST=smtp.gmail.com
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_FROM=alerts@manufacturing.com
ALERT_EMAIL_TO=quality@manufacturing.com,production@manufacturing.com
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Dashboard & Monitoring
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
GRAFANA_URL=http://localhost:3000
PROMETHEUS_PORT=9090

# Quality Thresholds
DEFECT_RATE_THRESHOLD=0.05  # 5% defect rate triggers alert
CRITICAL_DEFECT_THRESHOLD=0.01  # 1% critical defects
PROCESS_DEVIATION_THRESHOLD=2.0  # Standard deviations

# Supplier Scoring
SUPPLIER_MIN_SCORE=70.0
SUPPLIER_EVALUATION_PERIOD_DAYS=90
SUPPLIER_WARNING_SCORE=75.0

# Customer Feedback
FEEDBACK_INTEGRATION_ENABLED=true
FEEDBACK_PROCESSING_INTERVAL=3600  # seconds
FEEDBACK_SENTIMENT_THRESHOLD=0.6

# Deployment Settings
API_WORKERS=4
API_TIMEOUT=300
MAX_UPLOAD_SIZE=104857600  # 100MB
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# Storage Paths
DATA_DIR=./data
MODEL_DIR=./models
LOG_DIR=./logs
BACKUP_DIR=./backups
IMAGE_ARCHIVE_DIR=./data/images
REPORT_OUTPUT_DIR=./reports

# Retention Policies
IMAGE_RETENTION_DAYS=90
LOG_RETENTION_DAYS=365
DEFECT_HISTORY_RETENTION_DAYS=730
